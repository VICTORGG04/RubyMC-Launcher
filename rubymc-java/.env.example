# RubyMC Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to the repository.

# Discord Bot Token (required for bot features)
# Get from https://discord.com/developers/applications
RUBYMC_DISCORD_BOT_TOKEN=

# Discord OAuth Client Secret (required for login via Discord)
# Get from https://discord.com/developers/applications → OAuth2
RUBYMC_DISCORD_CLIENT_SECRET=
