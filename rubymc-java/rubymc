#!/usr/bin/env bash
set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

HOST="${RUBYMC_HOST:-127.0.0.1}"
PORT="${RUBYMC_PORT:-4567}"
URL="http://${HOST}:${PORT}"
RUN_DIR="$ROOT/tmp/rubymc"
PID_FILE="$RUN_DIR/web.pid"
LOG_FILE="$RUN_DIR/web.log"

# Controle automático do servidor Java quando o projeto sobe/desce.
AUTO_JAVA_SERVER="${RUBYMC_AUTO_SERVERS:-true}"

mkdir -p "$RUN_DIR"

say() { echo "[RubyMC] $*"; }
ok()  { echo "[OK] $*"; }
warn(){ echo "[AVISO] $*"; }
err() { echo "[ERRO] $*" >&2; }

ensure_gemfile() {
  say "Verificando Gemfile..."
  touch Gemfile

  if ! grep -q '^source ' Gemfile; then
    tmpfile="$(mktemp)"
    {
      echo 'source "https://rubygems.org"'
      echo
      cat Gemfile
    } > "$tmpfile"
    mv "$tmpfile" Gemfile
  fi

  sed -i "/^[[:space:]]*gem[[:space:]]['\"]webrick['\"]/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]rubyzip['\"]/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]json['\"]/d" Gemfile
  sed -i "/glimmer-dsl-tk/d" Gemfile
  sed -i "/glimmer-dsl-libui/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]tk['\"]/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]libui['\"]/d" Gemfile

  printf '\ngem "webrick", "~> 1.9"\n' >> Gemfile
  printf 'gem "rubyzip", "~> 2.3"\n' >> Gemfile
  printf 'gem "json"\n' >> Gemfile
}

install_deps() {
  if ! command -v bundle >/dev/null 2>&1; then
    say "Bundler não encontrado. Instalando..."
    gem install bundler
  fi

  ensure_gemfile

  if bundle check >/dev/null 2>&1; then
    ok "Dependências já instaladas."
  else
    say "Instalando dependências..."
    bundle install
  fi
}

free_port() {
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${PORT}/tcp" >/dev/null 2>&1 || true
  elif command -v lsof >/dev/null 2>&1; then
    pid="$(lsof -t -iTCP:${PORT} -sTCP:LISTEN 2>/dev/null || true)"
    if [ -n "$pid" ]; then
      kill -9 $pid >/dev/null 2>&1 || true
    fi
  fi
}

json_escape() {
  # Escape simples para strings usadas nos payloads JSON desta CLI.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

require_curl() {
  if ! command -v curl >/dev/null 2>&1; then
    err "curl não encontrado. Instale curl para controlar servidores via API."
    return 1
  fi
}

web_pid_running() {
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1
    return
  fi

  return 1
}

wait_web_ready() {
  local attempts="${1:-30}"
  local i=0

  require_curl || return 1

  while [ "$i" -lt "$attempts" ]; do
    if curl -fsS "${URL}/api/status" >/dev/null 2>&1 || curl -fsS "${URL}/" >/dev/null 2>&1; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done

  return 1
}

api_post_json() {
  local endpoint="$1"
  local payload="$2"

  require_curl || return 1

  curl -fsS \
    -X POST \
    -H "Content-Type: application/json" \
    -H "Accept: application/json" \
    --data "$payload" \
    "${URL}${endpoint}"
}

api_get() {
  local endpoint="$1"

  require_curl || return 1

  curl -fsS \
    -H "Accept: application/json" \
    "${URL}${endpoint}"
}

java_server_action() {
  local action="$1"
  local api_action

  case "$action" in
    start)   api_action="start_server" ;;
    stop)    api_action="stop_server" ;;
    restart) api_action="restart_server" ;;
    *)
      err "Ação Java inválida: $action"
      return 1
      ;;
  esac

  say "Executando servidor Java: ${action}"
  if api_post_json "/api/action" "{\"action\":\"${api_action}\"}" >/tmp/rubymc_java_server_response.$$ 2>/tmp/rubymc_java_server_error.$$; then
    cat /tmp/rubymc_java_server_response.$$
    echo
    ok "Servidor Java: ${action} solicitado."
    rm -f /tmp/rubymc_java_server_response.$$ /tmp/rubymc_java_server_error.$$
    return 0
  fi

  warn "Falha ao solicitar ${action} do servidor Java:"
  cat /tmp/rubymc_java_server_error.$$ 2>/dev/null || true
  echo
  rm -f /tmp/rubymc_java_server_response.$$ /tmp/rubymc_java_server_error.$$
  return 1
}

game_server_action() {
  local action="$1"

  if ! wait_web_ready 5; then
    warn "Servidor web/API não está disponível em ${URL}. Inicie o projeto antes de controlar servidores de jogo."
    return 1
  fi

  java_server_action "$action"
}

start_game_servers_for_project() {
  if [ "${AUTO_JAVA_SERVER:-true}" = "true" ]; then
    game_server_action start || true
  else
    say "Auto-start do servidor Java desativado."
  fi
}

stop_game_servers_for_project() {
  if web_pid_running || wait_web_ready 2; then
    game_server_action stop || true
  else
    warn "API web indisponível. Não foi possível parar o servidor Java."
  fi
}

status_game_servers() {
  echo
  echo "Servidor Java:"

  if ! wait_web_ready 2; then
    echo "  API indisponível em ${URL}"
    return 0
  fi

  if require_curl >/dev/null 2>&1; then
    api_get "/api/server/status" 2>/dev/null || echo "  Não foi possível consultar /api/server/status"
    echo
  fi
}

stop_server() {
  local keep_game_servers=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --keep-servers|--no-servers)
        keep_game_servers=1
        ;;
    esac
    shift
  done

  if [ "$keep_game_servers" -eq 0 ]; then
    say "Parando servidores de jogo vinculados ao projeto..."
    stop_game_servers_for_project || true
  else
    say "Mantendo servidores de jogo ativos."
  fi

  say "Parando servidor web antigo, se existir..."

  if [ -f "$PID_FILE" ]; then
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ]; then
      kill "$old_pid" >/dev/null 2>&1 || true
      sleep 1
      kill -9 "$old_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$PID_FILE"
  fi

  pkill -f "app/server.rb" >/dev/null 2>&1 || true
  free_port

  ok "Servidor web parado/liberado."
  stop_bot
}

start_server() {
  local simulate_flag=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --simulate)
        simulate_flag="--simulate"
        ;;
      --no-servers)
        AUTO_JAVA_SERVER="false"
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        warn "Opção ignorada no start: $1"
        ;;
    esac
    shift
  done

  if [ "${RUBYMC_SIMULATE}" = "1" ]; then
    simulate_flag="--simulate"
  fi

  if [ -n "$simulate_flag" ]; then
    say "Modo simulação ativado! (20 jogadores + Discord mock)"
  fi

  install_deps
  stop_server --keep-servers

  say "Iniciando RubyMC Launcher em ${URL}"

  nohup bundle exec ruby app/server.rb $simulate_flag > "$LOG_FILE" 2>&1 &
  new_pid="$!"
  echo "$new_pid" > "$PID_FILE"

  sleep 2

  if ! kill -0 "$new_pid" >/dev/null 2>&1; then
    echo "[ERRO] O servidor web não iniciou. Últimos logs:"
    tail -n 80 "$LOG_FILE" || true
    exit 1
  fi

  ok "Servidor web iniciado. PID: $new_pid${simulate_flag:+ (modo simulação)}"

  if ! wait_web_ready 30; then
    warn "Servidor web iniciou, mas a API ainda não respondeu em ${URL}."
  fi

  start_bot

  start_game_servers_for_project

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "${URL}/?v=latest-update" >/dev/null 2>&1 || true
  fi

  echo
  say "Acesse: ${URL}/?v=latest-update"
  say "Use './rubymc logs' para ver logs."
  say "Use './rubymc stop' para parar projeto + servidores."
  say "Use './rubymc server start' ou './rubymc server stop' para controlar o servidor."
}

restart_server() {
  local args=("$@")
  stop_server
  start_server "${args[@]}"
}

status_server() {
  echo "Projeto: $ROOT"
  echo "URL: ${URL}"

  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" >/dev/null 2>&1; then
      echo "Servidor web: rodando (PID $pid)"
    else
      echo "Servidor web: PID salvo, mas processo morto"
    fi
  else
    echo "Servidor web: sem PID salvo"
  fi

  if command -v lsof >/dev/null 2>&1; then
    echo
    lsof -nP -iTCP:${PORT} -sTCP:LISTEN || true
  fi

  echo
  status_bot
  status_game_servers
}

show_logs() {
  touch "$LOG_FILE"
  tail -f "$LOG_FILE"
}

run_tests() {
  install_deps
  echo "[RubyMC] Verificando sintaxe Ruby..."
  [ -f app/server.rb ] && ruby -c app/server.rb
  [ -f app/console.rb ] && ruby -c app/console.rb
  [ -f lib/web_launcher_app.rb ] && ruby -c lib/web_launcher_app.rb
  [ -f bin/run_checks.rb ] && ruby bin/run_checks.rb || true
  echo "[RubyMC] Verificando bundle..."
  bundle check
  ok "Testes básicos concluídos."
}

open_classic() {
  install_deps
  ruby app/console.rb
}

organize_project() {
  echo "[AVISO] Comando 'organize' foi movido para archive/scripts/. Use apenas se necessário."
  echo "  ruby archive/scripts/organize_project_root.rb --apply"
}

ai_ask() {
  install_deps
  shift
  local question="$*"
  if [ -z "$question" ]; then
    echo "[ERRO] Use: ./rubymc ai \"sua pergunta\""
    exit 1
  fi
  bundle exec ruby lib/rubymc/ai_cli.rb ask "$question"
}

ai_chat() {
  install_deps
  bundle exec ruby lib/rubymc/ai_cli.rb chat
}

BOT_PID_FILE="$RUN_DIR/bot.pid"
BOT_LOG_FILE="$RUN_DIR/bot.log"

start_bot() {
  install_deps

  if [ -f "$BOT_PID_FILE" ]; then
    pid="$(cat "$BOT_PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
      say "Bot já está rodando (PID $pid). Use './rubymc bot restart' para reiniciar."
      return
    fi
    rm -f "$BOT_PID_FILE"
  fi

  say "Iniciando bot Discord..."

  nohup bundle exec ruby app/bot.rb > "$BOT_LOG_FILE" 2>&1 &
  new_pid="$!"
  echo "$new_pid" > "$BOT_PID_FILE"

  sleep 2

  if ! kill -0 "$new_pid" >/dev/null 2>&1; then
    echo "[ERRO] O bot não iniciou. Últimos logs:"
    tail -n 40 "$BOT_LOG_FILE" || true
    exit 1
  fi

  ok "Bot Discord iniciado. PID: $new_pid"
  say "Use './rubymc bot logs' para ver logs."
  say "Use './rubymc bot stop' para parar."
}

stop_bot() {
  say "Parando bot Discord..."

  if [ -f "$BOT_PID_FILE" ]; then
    pid="$(cat "$BOT_PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ]; then
      kill "$pid" >/dev/null 2>&1 || true
      sleep 1
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$BOT_PID_FILE"
  fi

  pkill -f "app/bot.rb" >/dev/null 2>&1 || true
  ok "Bot Discord parado."
}

status_bot() {
  if [ -f "$BOT_PID_FILE" ]; then
    pid="$(cat "$BOT_PID_FILE")"
    if kill -0 "$pid" >/dev/null 2>&1; then
      echo "Bot Discord: rodando (PID $pid)"
    else
      echo "Bot Discord: PID salvo, mas processo morto"
    fi
  else
    echo "Bot Discord: parado"
  fi
}

bot_logs() {
  touch "$BOT_LOG_FILE"
  tail -f "$BOT_LOG_FILE"
}

server_cli() {
  local action="${1:-status}"

  case "$action" in
    start|stop|restart)
      game_server_action "$action"
      ;;
    status)
      status_game_servers
      ;;
    logs)
      show_logs
      ;;
    *)
      echo "Uso: ./rubymc server [start|stop|restart|status|logs]"
      echo ""
      echo "Exemplos:"
      echo "  ./rubymc server start"
      echo "  ./rubymc server stop"
      echo "  ./rubymc server restart"
      echo "  ./rubymc server status"
      echo "  ./rubymc server logs"
      return 1
      ;;
  esac
}

usage() {
  cat <<USAGE
Uso: ./rubymc [comando] [opções]

Projeto:
  start|web [opções]     Inicia web + bot + servidor Java
  stop                   Para servidor Java + web + bot
  restart [opções]       Reinicia servidor Java + web + bot
  status                 Mostra status do projeto, bot e servidor
  logs                   Mostra logs da web
  test                   Testes básicos
  classic                Abre console clássico
  organize               Instruções de organização
  install                Instala dependências

Servidor:
  server [start|stop|restart|status|logs]
  servers ...            Alias de server

Bot:
  bot [start|stop|restart|status|logs]

IA:
  ai "pergunta"
  ai-chat|aic

Opções do start/restart:
  --simulate                         Ativa modo simulação
  --no-servers                       Não inicia servidor Java junto

Variáveis:
  RUBYMC_AUTO_SERVERS=true|false
  RUBYMC_HOST=127.0.0.1
  RUBYMC_PORT=4567
USAGE
}

case "${1:-start}" in
  start|web)
    shift
    start_server "$@"
    ;;
  stop)
    shift || true
    stop_server "$@"
    ;;
  restart)
    shift
    restart_server "$@"
    ;;
  status)
    status_server
    ;;
  logs)
    show_logs
    ;;
  test)
    run_tests
    ;;
  classic)
    open_classic
    ;;
  organize)
    organize_project
    ;;
  install)
    install_deps
    ;;
  ai)
    ai_ask "$@"
    ;;
  ai-chat|aic)
    ai_chat
    ;;
  server|servers|game-server|game-servers)
    shift
    server_cli "$@"
    ;;
  bot)
    cmd="${2:-start}"
    case "$cmd" in
      start)
        start_bot
        ;;
      stop)
        stop_bot
        ;;
      restart)
        stop_bot
        start_bot
        ;;
      status)
        status_bot
        ;;
      logs)
        bot_logs
        ;;
      *)
        echo "Uso: ./rubymc bot [start|stop|restart|status|logs]"
        exit 1
        ;;
    esac
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac