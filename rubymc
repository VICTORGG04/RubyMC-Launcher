#!/usr/bin/env bash
set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

HOST="${RUBYMC_HOST:-127.0.0.1}"
PORT="${RUBYMC_PORT:-4567}"
URL="http://${HOST}:${PORT}"
RUN_DIR="$ROOT/tmp/rubymc"
PID_FILE="$RUN_DIR/web.pid"
LOG_FILE="$RUN_DIR/web.log"

mkdir -p "$RUN_DIR"

say() { echo "[RubyMC] $*"; }
ok()  { echo "[OK] $*"; }
warn(){ echo "[AVISO] $*"; }

ensure_gemfile() {
  say "Verificando Gemfile..."
  touch Gemfile

  if ! grep -q '^source ' Gemfile; then
    tmpfile="$(mktemp)"
    {
      echo 'source "https://rubygems.org"'
      echo
      cat Gemfile
    } > "$tmpfile"
    mv "$tmpfile" Gemfile
  fi

  sed -i "/^[[:space:]]*gem[[:space:]]['\"]webrick['\"]/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]rubyzip['\"]/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]json['\"]/d" Gemfile
  sed -i "/glimmer-dsl-tk/d" Gemfile
  sed -i "/glimmer-dsl-libui/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]tk['\"]/d" Gemfile
  sed -i "/^[[:space:]]*gem[[:space:]]['\"]libui['\"]/d" Gemfile

  printf '\ngem "webrick", "~> 1.9"\n' >> Gemfile
  printf 'gem "rubyzip", "~> 2.3"\n' >> Gemfile
  printf 'gem "json"\n' >> Gemfile
}

install_deps() {
  if ! command -v bundle >/dev/null 2>&1; then
    say "Bundler não encontrado. Instalando..."
    gem install bundler
  fi

  ensure_gemfile

  if bundle check >/dev/null 2>&1; then
    ok "Dependências já instaladas."
  else
    say "Instalando dependências..."
    bundle install
  fi
}

free_port() {
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${PORT}/tcp" >/dev/null 2>&1 || true
  elif command -v lsof >/dev/null 2>&1; then
    pid="$(lsof -t -iTCP:${PORT} -sTCP:LISTEN 2>/dev/null || true)"
    if [ -n "$pid" ]; then
      kill -9 $pid >/dev/null 2>&1 || true
    fi
  fi
}

stop_server() {
  say "Parando servidor web antigo, se existir..."

  if [ -f "$PID_FILE" ]; then
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ]; then
      kill "$old_pid" >/dev/null 2>&1 || true
      sleep 1
      kill -9 "$old_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$PID_FILE"
  fi

  pkill -f "app/server.rb" >/dev/null 2>&1 || true
  free_port

  ok "Servidor parado/liberado."
  stop_bot
}

start_server() {
  local simulate_flag=""

  if [ "$1" = "--simulate" ] || [ "${RUBYMC_SIMULATE}" = "1" ]; then
    simulate_flag="--simulate"
    say "Modo simulação ativado! (20 jogadores + Discord mock)"
  fi

  install_deps
  stop_server

  say "Iniciando RubyMC Launcher em ${URL}"

  nohup bundle exec ruby app/server.rb $simulate_flag > "$LOG_FILE" 2>&1 &
  new_pid="$!"
  echo "$new_pid" > "$PID_FILE"

  sleep 2

  if ! kill -0 "$new_pid" >/dev/null 2>&1; then
    echo "[ERRO] O servidor não iniciou. Últimos logs:"
    tail -n 80 "$LOG_FILE" || true
    exit 1
  fi

  ok "Servidor iniciado. PID: $new_pid${simulate_flag:+ (modo simulação)}"

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "${URL}/?v=latest-update" >/dev/null 2>&1 || true
  fi

  echo
  say "Acesse: ${URL}/?v=latest-update"
  say "Use './rubymc logs' para ver logs."
  say "Use './rubymc stop' para parar."

  start_bot
}

status_server() {
  echo "Projeto: $ROOT"
  echo "URL: ${URL}"

  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" >/dev/null 2>&1; then
      echo "Servidor web: rodando (PID $pid)"
    else
      echo "Servidor web: PID salvo, mas processo morto"
    fi
  else
    echo "Servidor web: sem PID salvo"
  fi

  if command -v lsof >/dev/null 2>&1; then
    echo
    lsof -nP -iTCP:${PORT} -sTCP:LISTEN || true
  fi

  echo
  status_bot
}

show_logs() {
  touch "$LOG_FILE"
  tail -f "$LOG_FILE"
}

run_tests() {
  install_deps
  echo "[RubyMC] Verificando sintaxe Ruby..."
  [ -f app/server.rb ] && ruby -c app/server.rb
  [ -f app/console.rb ] && ruby -c app/console.rb
  [ -f lib/web_launcher_app.rb ] && ruby -c lib/web_launcher_app.rb
  [ -f bin/run_checks.rb ] && ruby bin/run_checks.rb || true
  echo "[RubyMC] Verificando bundle..."
  bundle check
  ok "Testes básicos concluídos."
}

open_classic() {
  install_deps
  ruby app/console.rb
}

organize_project() {
  echo "[AVISO] Comando 'organize' foi movido para archive/scripts/. Use apenas se necessário."
  echo "  ruby archive/scripts/organize_project_root.rb --apply"
}

ai_ask() {
  install_deps
  shift
  local question="$*"
  if [ -z "$question" ]; then
    echo "[ERRO] Use: ./rubymc ai \"sua pergunta\""
    exit 1
  fi
  bundle exec ruby lib/rubymc/ai_cli.rb ask "$question"
}

ai_chat() {
  install_deps
  bundle exec ruby lib/rubymc/ai_cli.rb chat
}

BOT_PID_FILE="$RUN_DIR/bot.pid"
BOT_LOG_FILE="$RUN_DIR/bot.log"

start_bot() {
  install_deps

  if [ -f "$BOT_PID_FILE" ]; then
    pid="$(cat "$BOT_PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
      say "Bot já está rodando (PID $pid). Use './rubymc bot restart' para reiniciar."
      return
    fi
    rm -f "$BOT_PID_FILE"
  fi

  say "Iniciando bot Discord..."

  nohup bundle exec ruby app/bot.rb > "$BOT_LOG_FILE" 2>&1 &
  new_pid="$!"
  echo "$new_pid" > "$BOT_PID_FILE"

  sleep 2

  if ! kill -0 "$new_pid" >/dev/null 2>&1; then
    echo "[ERRO] O bot não iniciou. Últimos logs:"
    tail -n 40 "$BOT_LOG_FILE" || true
    exit 1
  fi

  ok "Bot Discord iniciado. PID: $new_pid"
  say "Use './rubymc bot logs' para ver logs."
  say "Use './rubymc bot stop' para parar."
}

stop_bot() {
  say "Parando bot Discord..."

  if [ -f "$BOT_PID_FILE" ]; then
    pid="$(cat "$BOT_PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ]; then
      kill "$pid" >/dev/null 2>&1 || true
      sleep 1
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$BOT_PID_FILE"
  fi

  pkill -f "app/bot.rb" >/dev/null 2>&1 || true
  ok "Bot Discord parado."
}

status_bot() {
  if [ -f "$BOT_PID_FILE" ]; then
    pid="$(cat "$BOT_PID_FILE")"
    if kill -0 "$pid" >/dev/null 2>&1; then
      echo "Bot Discord: rodando (PID $pid)"
    else
      echo "Bot Discord: PID salvo, mas processo morto"
    fi
  else
    echo "Bot Discord: parado"
  fi
}

bot_logs() {
  touch "$BOT_LOG_FILE"
  tail -f "$BOT_LOG_FILE"
}

case "${1:-start}" in
  start|web)
    shift
    start_server "$@"
    ;;
  stop)
    stop_server
    ;;
  restart)
    stop_server
    start_server
    ;;
  status)
    status_server
    ;;
  logs)
    show_logs
    ;;
  test)
    run_tests
    ;;
  classic)
    open_classic
    ;;
  organize)
    organize_project
    ;;
  install)
    install_deps
    ;;
  ai)
    ai_ask "$@"
    ;;
  ai-chat|aic)
    ai_chat
    ;;
  bot)
    cmd="${2:-start}"
    case "$cmd" in
      start)
        start_bot
        ;;
      stop)
        stop_bot
        ;;
      restart)
        stop_bot
        start_bot
        ;;
      status)
        status_bot
        ;;
      logs)
        bot_logs
        ;;
      *)
        echo "Uso: ./rubymc bot [start|stop|restart|status|logs]"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Uso: ./rubymc [start|web|stop|restart|status|logs|test|classic|organize|install|ai|ai-chat|bot]"
    echo ""
    echo "  start [--simulate]  Inicia o servidor web (--simulate: modo simulação com 20 jogadores)"
    echo "  web                 Atalho para start"
    echo "  bot [comando]       Gerencia o bot Discord (start|stop|restart|status|logs)"
    exit 1
    ;;
esac
